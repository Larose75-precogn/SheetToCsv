[Unit]
Description=Claude Code Remote Control (sessions persistantes)
Documentation=https://code.claude.com/docs/en/claude-code-on-the-web
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.claude-rc/rc-up.sh
ExecStop=%h/.claude-rc/rc-down.sh
# rc-up.sh sort en 1 si une session du manifeste a un cwd manquant :
# c'est un avertissement, pas une panne du service.
SuccessExitStatus=0 1
Environment=RC_LOGDIR=%h/.local/state/claude-rc

[Install]
WantedBy=default.target
